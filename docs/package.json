{
  "name": "slotsmith-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "redirects": "node scripts/redirects.ts",
    "build": "node scripts/reference.ts && node scripts/redirects.ts && astro build && node scripts/verify-site.ts",
    "check": "astro check && tsc --noEmit && tsc --noEmit -p samples && node scripts/check-snippets.ts",
    "test": "vitest run",
    "verify": "node scripts/verify-site.ts",
    "reference": "node scripts/reference.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/big-shoulders": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
