---
import Base from "@/layouts/Base.astro";
import HashRedirect from "@/components/HashRedirect.astro";
import Hero from "@/components/landing/Hero.astro";
import Swap from "@/components/landing/Swap.astro";
import Parts from "@/components/landing/Parts.astro";
import Cards from "@/components/landing/Cards.astro";
import WorksWith from "@/components/landing/WorksWith.astro";
import Languages from "@/components/landing/Languages.astro";
import Agents from "@/components/landing/Agents.astro";
import TrustStrip from "@/components/landing/TrustStrip.astro";
import Close from "@/components/landing/Close.astro";
import Faq from "@/components/Faq.astro";
import MotionLoader from "@/components/landing/MotionLoader.astro";
import { landingFaq } from "@/data/faq";
import { langFromParam, langPaths, t } from "@/i18n";
import { getFacts } from "@/lib/facts";
import { ogUrl } from "@/lib/og";
import { faqPage, softwareSourceCode, webSite } from "@/lib/structured-data";

export function getStaticPaths() {
  return langPaths();
}

const lang = langFromParam(Astro.params.lang);
// The FAQ and its FAQPage JSON-LD are one list, so the markup says what the page shows.
const faq = landingFaq(lang);
const jsonLd = [webSite(lang), softwareSourceCode(getFacts(), lang, ogUrl(lang, "/")), faqPage(faq)];
---
<Base lang={lang} title={null} description={t(lang, "site.positioning")} path="/" jsonLd={jsonLd}>
  {lang === "en" && <HashRedirect />}
  <Hero lang={lang} />
  <Swap lang={lang} />
  <Parts lang={lang} />
  <Cards lang={lang} />
  <WorksWith lang={lang} />
  <Languages lang={lang} />
  <Agents lang={lang} />
  <TrustStrip lang={lang} />
  <Faq items={faq} lang={lang} />
  <Close lang={lang} />
  <MotionLoader />
</Base>
