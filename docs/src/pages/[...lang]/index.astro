---
import Base from "@/layouts/Base.astro";
import HashRedirect from "@/components/HashRedirect.astro";
import Hero from "@/components/landing/Hero.astro";
import Swap from "@/components/landing/Swap.astro";
import Parts from "@/components/landing/Parts.astro";
import Cards from "@/components/landing/Cards.astro";
import { langFromParam, langPaths, t } from "@/i18n";

export function getStaticPaths() {
  return langPaths();
}

const lang = langFromParam(Astro.params.lang);
---
<Base lang={lang} title={null} description={t(lang, "site.positioning")} path="/">
  {lang === "en" && <HashRedirect />}
  <Hero lang={lang} />
  <Swap lang={lang} />
  <Parts lang={lang} />
  <Cards lang={lang} />
</Base>
