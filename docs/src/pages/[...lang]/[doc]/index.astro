---
/**
 * A top-level docs page (`/theming/`). Its MDX may use the blocks below by
 * name; a live island (the theme preview) is imported in the MDX itself,
 * since a client directive needs the import there.
 */
import DocPage from "@/components/DocPage.astro";
import Note from "@/components/Note.astro";
import SampleCode from "@/components/SampleCode.astro";
import Tabs from "@/components/Tabs.astro";
import { langFromParam, langPaths } from "@/i18n";
import { DOC_SLUGS, OWN_TEMPLATE_DOCS } from "@/lib/pages";
import { getProse } from "@/lib/prose";

export function getStaticPaths() {
  return langPaths().flatMap(({ params }) => DOC_SLUGS.filter((doc) => !OWN_TEMPLATE_DOCS.includes(doc)).map((doc) => ({ params: { ...params, doc } })));
}

const lang = langFromParam(Astro.params.lang);
const { doc } = Astro.params;
const prose = await getProse(lang, doc);
const components = { Note, SampleCode, Tabs };
---
<DocPage lang={lang} path={`/${doc}/`} prose={prose} components={components} />
