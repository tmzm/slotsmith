---
/**
 * Docs page layout: Base plus the sidebar column, the "On this page" list,
 * the "Edit this page" link and the page's last-updated date from git. The
 * article is what search indexes (Pagefind), under the page's section name.
 */
import Base, { type Props as BaseProps } from "./Base.astro";
import Sidebar from "@/components/Sidebar.astro";
import LastUpdated from "@/components/LastUpdated.astro";
import { t } from "@/i18n";
import { searchSection } from "@/lib/search-messages";
import { editUrl } from "@/lib/page";

interface Props extends BaseProps {
  /** The MDX file behind the page; omit it and the "Edit this page" link is left out. */
  sourcePath?: string;
  /** Set to "en" when the contents links are English on an Arabic page. */
  tocLang?: "en";
  toc?: { id: string; text: string; depth: 2 | 3 }[];
  /** The newest commit date of the page's sources; null hides the date. */
  lastUpdated?: string | null;
}

const { sourcePath, toc = [], tocLang, lastUpdated = null, ...base } = Astro.props;
const { lang, path } = base;
---
<Base {...base}>
  <Sidebar slot="sidebar" lang={lang} path={path} />
  <div class="docs" data-toc={toc.length > 0 || undefined}>
    <article class="docs__article" data-pagefind-body data-pagefind-meta={`section:${searchSection(lang, path)}`}>
      <slot />
      {(sourcePath || lastUpdated) && (
        <footer class="docs__meta" data-pagefind-ignore>
          {sourcePath && <a class="docs__edit" href={editUrl(sourcePath)}>{t(lang, "common.editPage")}</a>}
          <LastUpdated lang={lang} date={lastUpdated} />
        </footer>
      )}
    </article>
    {
      toc.length > 0 && (
        <nav class="toc" aria-labelledby="toc-title">
          <p class="toc__title" id="toc-title">{t(lang, "common.onThisPage")}</p>
          <ul>
            {toc.map((heading) => (
              <li data-depth={heading.depth}>
                <a href={`#${heading.id}`} lang={tocLang} dir={tocLang && "ltr"}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<style>
  /* "Edit this page" and the last-updated date, stacked under the article. */
  .docs__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-block-start: 3rem;
  }

  .docs__meta :global(.docs__edit),
  .docs__meta :global(.last-updated) {
    margin: 0;
  }
</style>
