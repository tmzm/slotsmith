---
/** Docs page header: display title, the answer-first lead, a mono `{key} value` meta row, then anything slotted (the Markdown controls). */
interface Props {
  title: string;
  lead?: string;
  meta?: { key: string; value: string }[];
  /** "en" on an Arabic page that shows English text. */
  contentLang?: "en";
}

const { title, lead, meta, contentLang } = Astro.props;
---
<header class="page-header" lang={contentLang} dir={contentLang && "ltr"}>
  <h1 class="display page-header__title">{title}</h1>
  {lead && <p class="page-header__lead">{lead}</p>}
  {
    meta && meta.length > 0 && (
      <ul class="page-header__meta">
        {meta.map((item) => (
          <li dir="ltr">
            <span class="page-header__meta-key">
              <span class="brace">{"{"}</span>
              {item.key}
              <span class="brace">{"}"}</span>
            </span>{" "}
            {item.value}
          </li>
        ))}
      </ul>
    )
  }
  <slot />
</header>
