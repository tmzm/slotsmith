---
/**
 * Links to the same page in the other language. A full page load, so lang,
 * dir and fonts apply cleanly. The accessible name starts with the visible
 * language name (WCAG 2.5.3); the hidden rest says what the link does.
 */
import { localePath, t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const other: Lang = lang === "en" ? "ar" : "en";
---
<a
  class="icon-button lang-switch"
  href={localePath(other, path)}
  hreflang={other}
>
  <span lang={other}>{t(lang, "switch.otherLanguage")}</span><span class="visually-hidden">, {t(lang, "switch.language")}</span>
</a>
