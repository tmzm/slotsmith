---
/** Thumb-reach actions below 768px: Menu, Search, Theme. */
import { t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<nav class="dock" aria-label={t(lang, "nav.dock")}>
  <button type="button" class="dock__button" data-menu-toggle aria-controls="site-nav" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h10" />
    </svg>
    {t(lang, "common.menu")}
  </button>
  <button type="button" class="dock__button" data-search-open>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="M20 20l-3.5-3.5" />
    </svg>
    {t(lang, "common.search")}
  </button>
  <button
    type="button"
    class="dock__button"
    data-theme-toggle
    data-label-to-light={t(lang, "switch.toLight")}
    data-label-to-dark={t(lang, "switch.toDark")}
    aria-label={t(lang, "switch.toLight")}
  >
    <svg class="theme-icon-to-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
    <svg class="theme-icon-to-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
    </svg>
    <span aria-hidden="true">{t(lang, "switch.theme")}</span>
  </button>
</nav>
