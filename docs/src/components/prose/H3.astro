---
/**
 * A level-3 prose heading that links to itself. The id is the slug MDX gives
 * the heading, the same one the "On this page" list links to.
 */
interface Props {
  id?: string;
}

const { id, ...rest } = Astro.props;
---
<h3 id={id} {...rest}>{id ? <a class="heading-anchor" href={`#${id}`}><slot /></a> : <slot />}</h3>
