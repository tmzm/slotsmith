---
/**
 * Renders a prose entry. An Arabic page with no Arabic twin shows the English
 * text inside lang="en" dir="ltr", after the "not translated" note. Section
 * headings link to themselves, so every one is an in-page anchor.
 */
import { render } from "astro:content";
import { t } from "@/i18n";
import type { Prose } from "@/lib/prose";
import H2 from "./prose/H2.astro";
import H3 from "./prose/H3.astro";

interface Props {
  prose: Prose;
  /** Further components the MDX may use, beside the headings (a component overview's blocks). */
  components?: Record<string, unknown>;
}

const { prose, components: extra = {} } = Astro.props;
const { Content } = await render(prose.entry);
const components = { ...extra, h2: H2, h3: H3 };
const fallback = prose.lang === "ar" && !prose.translated;
---
{
  fallback ? (
    <>
      <p class="untranslated" data-pagefind-ignore>{t("ar", "common.untranslated")}</p>
      <div lang="en" dir="ltr" class="prose">
        <Content components={components} />
      </div>
    </>
  ) : (
    <div class="prose">
      <Content components={components} />
    </div>
  )
}
