---
/**
 * The header's search button and the loader behind it (docs/DESIGN.md
 * "Header", "Search").
 *
 * No search control works before the loader runs, so none shows: the header
 * button is in the HTML but `hidden`, and every other `[data-search-open]`
 * (the dock's Search button) stays invisible in its place until the loader
 * marks it `data-search-ready`. A page whose script never ran has no dead
 * control, and nothing moves when the controls appear: the header button takes
 * space the spacer held, the dock button already had its cell.
 *
 * The dialog (`islands/SearchDialog.tsx`), React and Pagefind load on the
 * first request to open: a click on a `[data-search-open]` (Base.astro turns
 * it into the `open-search` window event), Ctrl+K, ⌘K or `/`. After that the
 * dialog listens for itself.
 */
import { t, type Lang } from "@/i18n";
import { searchMessages } from "@/lib/search-messages";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// "<" escaped so no text can close the script element.
const data = JSON.stringify({ lang, messages: searchMessages(lang) }).replaceAll("<", "\\u003c");
---
<button type="button" class="icon-button search-button" data-search-open data-search-trigger aria-keyshortcuts="Control+K Meta+K /" hidden>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="11" cy="11" r="7" />
    <path d="M20 20l-3.5-3.5" />
  </svg>
  <span>{t(lang, "common.search")}</span>
  <kbd dir="ltr" aria-hidden="true" data-search-keys>⌘K</kbd>
</button>
<script is:inline type="application/json" id="search-data" set:html={data} />
<noscript><style is:inline>[data-search-open] { display: none !important; }</style></noscript>

<style is:global>
  /* Until the loader runs: in place (the dock keeps its three cells) but neither seen nor reachable. */
  [data-search-open]:not([data-search-ready]) {
    visibility: hidden;
  }

  /* The header's other controls (`.icon-button`), with a label and the shortcut beside the icon. */
  .icon-button.search-button {
    display: none;
    grid-auto-flow: column;
    gap: 0.5rem;
    padding-inline: 0.75rem 0.5rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .icon-button.search-button:hover {
    color: var(--ink);
  }

  .icon-button.search-button svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .icon-button.search-button kbd {
    font-size: 0.75rem;
  }

  /* Below 768px the dock's Search button is the way in. */
  @media (min-width: 768px) {
    .icon-button.search-button:not([hidden]) {
      display: inline-grid;
    }
  }
</style>

<script>
  import { isSearchShortcut } from "@/lib/search";

  const data = document.getElementById("search-data");
  const trigger = document.querySelector<HTMLElement>("[data-search-trigger]");
  if (data && trigger) {
    const keys = trigger.querySelector("[data-search-keys]");
    if (keys && !/Mac|iPhone|iPad/.test(navigator.platform)) keys.textContent = "Ctrl K";
    trigger.hidden = false;
    for (const button of document.querySelectorAll<HTMLElement>("[data-search-open]")) {
      button.setAttribute("data-search-ready", "");
      // Safari does not focus a clicked button; focused, it is where the dialog returns focus on close.
      button.addEventListener("click", () => button.focus({ preventScroll: true }), { capture: true });
    }

    const dialog = () => import("@/islands/SearchDialog");
    let mounting: Promise<void> | undefined;
    /** Loads the dialog and mounts it open; from then on it handles the event and the keys. */
    const mount = () => {
      mounting ??= dialog()
        .then(({ mountSearch }) => {
          window.removeEventListener("open-search", mount);
          window.removeEventListener("keydown", onKey);
          mountSearch(JSON.parse(data.textContent ?? ""));
        })
        .catch(() => {
          // The chunk did not load (offline): the next request tries again.
          mounting = undefined;
        });
    };
    const onKey = (event: KeyboardEvent) => {
      if (!isSearchShortcut(event)) return;
      event.preventDefault();
      mount();
    };
    window.addEventListener("open-search", mount);
    window.addEventListener("keydown", onKey);
    // Pointing at the button fetches the dialog's code ahead of the click.
    trigger.addEventListener("pointerenter", () => void dialog().catch(() => {}), { once: true });
  }
</script>
