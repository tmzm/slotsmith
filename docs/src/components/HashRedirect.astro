---
import { HASH_ROUTES } from "@/lib/redirects";

const routes = JSON.stringify(HASH_ROUTES);
---
<script is:inline define:vars={{ routes }}>
  (function () {
    var hash = location.hash;
    if (!hash || hash === "#" || hash.charAt(1) !== "/") return;
    var table = JSON.parse(routes);
    var path = hash.slice(1).split(/[?#]/)[0].replace(/^\/+|\/+$/g, "");
    var target = "/";
    if (path === "") target = table[""];
    else {
      var m = /^docs\/([^\/]+)$/.exec(path);
      if (m && Object.prototype.hasOwnProperty.call(table, m[1])) target = table[m[1]];
    }
    location.replace(target);
  })();
</script>
