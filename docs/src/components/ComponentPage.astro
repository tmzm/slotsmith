---
/** A page under /components/<component>/: overview, API, adapters or one guide. */
import DocPage from "@/components/DocPage.astro";
import { componentMeta } from "@/data/components";
import type { Lang } from "@/i18n";
import { componentPageMeta, type ComponentSection } from "@/lib/pages";
import { getOptionalProse } from "@/lib/prose";
import { getReference } from "@/lib/reference";

interface Props {
  lang: Lang;
  component: string;
  /** "index", "api", "adapters", or a guide slug prefixed with "guides/". */
  section: ComponentSection;
  /** False when the template renders the page's whole content (generated API and adapters pages). */
  stub?: boolean;
  /** Headings the template renders, for "On this page". */
  headings?: { id: string; text: string; depth: 2 | 3 }[];
  /** Components the prose MDX may use (the overview's blocks). */
  components?: Record<string, unknown>;
}

const { lang, component, section, stub, headings, components } = Astro.props;
const meta = componentMeta(component);
const reference = getReference(meta.slug);
// docs/DESIGN.md "Page header": the entry point and stylesheet in the mono meta row.
const pageMeta = [
  { key: "entry", value: reference.entry },
  { key: "css", value: reference.css },
];
// Title, description and path come from the same function `allPages()` uses, so the sitemap and llms files match the page.
const { title, description, path, proseSlug, override } = componentPageMeta(lang, meta, section);

const prose = await getOptionalProse(lang, proseSlug);
const fallback = { title, description };
---
<DocPage lang={lang} path={path} prose={prose} fallback={fallback} title={override ? title : undefined} meta={pageMeta} stub={stub} headings={headings} components={components}>
  <slot />
</DocPage>
