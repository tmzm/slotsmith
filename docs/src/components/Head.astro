---
/**
 * Everything inside <head>: title, description, canonical and hreflang links,
 * social cards, the link to the page's Markdown copy, its JSON-LD, the
 * pre-paint theme script and the self-hosted fonts.
 *
 * Fonts are declared here rather than through the @fontsource stylesheets so
 * the preload links and the @font-face rules share one hashed URL, and so the
 * Arabic faces are only emitted on Arabic pages. Each web font is followed by
 * fallback faces, local fonts scaled to its width (lib/font-fallbacks.ts), so
 * the swap from the fallback to the web font does not move the text.
 */
import JsonLd from "./JsonLd.astro";
import ThemeScript from "./ThemeScript.astro";
import { alternates, canonicalUrl, pageTitle } from "@/lib/page";
import type { Lang } from "@/i18n";
import { ARABIC_RANGE as ARABIC, LATIN_RANGE as LATIN, fallbackFaceCss, fallbackFaces } from "@/lib/font-fallbacks";
import { OG_HEIGHT, OG_WIDTH, ogUrl } from "@/lib/og";
import { markdownUrl } from "@/lib/seo-files";
import { SITE } from "../../site.config";

import bigShoulders900 from "@fontsource/big-shoulders/files/big-shoulders-latin-900-normal.woff2?url";
import geist400 from "@fontsource/geist/files/geist-latin-400-normal.woff2?url";
import geist500 from "@fontsource/geist/files/geist-latin-500-normal.woff2?url";
import geist600 from "@fontsource/geist/files/geist-latin-600-normal.woff2?url";
import jetbrains400 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import jetbrains500 from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url";
import alexandria800 from "@fontsource/alexandria/files/alexandria-arabic-800-normal.woff2?url";
import notoArabic400 from "@fontsource/noto-sans-arabic/files/noto-sans-arabic-arabic-400-normal.woff2?url";
import notoArabic500 from "@fontsource/noto-sans-arabic/files/noto-sans-arabic-arabic-500-normal.woff2?url";
import notoArabic700 from "@fontsource/noto-sans-arabic/files/noto-sans-arabic-arabic-700-normal.woff2?url";

interface Props {
  lang: Lang;
  title: string | null;
  description: string;
  path: string;
  /** Structured data, one `application/ld+json` script per object. */
  jsonLd?: object[];
}

const { lang, title, description, path, jsonLd = [] } = Astro.props;

const face = (family: string, weight: number, url: string, range: string) =>
  `@font-face{font-family:"${family}";font-style:normal;font-weight:${weight};font-display:swap;src:url(${url}) format("woff2");unicode-range:${range}}`;

const faces = [
  face("Big Shoulders", 900, bigShoulders900, LATIN),
  face("Geist", 400, geist400, LATIN),
  face("Geist", 500, geist500, LATIN),
  face("Geist", 600, geist600, LATIN),
  face("JetBrains Mono", 400, jetbrains400, LATIN),
  face("JetBrains Mono", 500, jetbrains500, LATIN),
];
if (lang === "ar") {
  faces.push(
    face("Alexandria", 800, alexandria800, ARABIC),
    face("Noto Sans Arabic", 400, notoArabic400, ARABIC),
    face("Noto Sans Arabic", 500, notoArabic500, ARABIC),
    face("Noto Sans Arabic", 700, notoArabic700, ARABIC),
  );
}
faces.push(...fallbackFaces(lang).map(fallbackFaceCss));
// Preload every face the page is sure to use, so each one is ready by the
// first layout. A face that arrives later is laid out in its fallback first,
// which costs a second text layout and, for the fallback, opening a local
// font. The layout's own chrome uses all of these on every page; the weight
// 500 faces are used by the landing hero and only here and there elsewhere,
// and a preload the page never uses is a console warning.
const preloads = [geist400, geist600, bigShoulders900, jetbrains400, jetbrains500];
if (lang === "ar") preloads.push(notoArabic400, notoArabic700, alexandria800);
if (title === null) preloads.push(geist500, ...(lang === "ar" ? [notoArabic500] : []));

/** Google's Tag Manager snippet, verbatim apart from the container id. */
const gtmScript = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${SITE.gtm}');`;

const fullTitle = pageTitle(lang, title);
const canonical = canonicalUrl(lang, path);
// Every page has an image at /og/<page>.png (pages/og/[...slug].png.ts).
const ogImageUrl = ogUrl(lang, path);
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="4" fill="#0f0e0b"/><path d="M12 9 5 16l7 7M20 9l7 7-7 7" fill="none" stroke="#c9a14a" stroke-width="3"/></svg>',
  );
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#0f0e0b" />
<!-- Google Tag Manager -->
<script is:inline set:html={gtmScript}></script>
<!-- End Google Tag Manager -->
<meta name="google-site-verification" content={SITE.googleSiteVerification} />
<ThemeScript />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates(path).map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
<link rel="alternate" type="text/markdown" href={markdownUrl(lang, path)} />
<link rel="icon" href={favicon} type="image/svg+xml" />
{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={faces.join("")}></style>
<meta property="og:type" content={title === null ? "website" : "article"} />
<meta property="og:site_name" content="slotsmith" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === "ar" ? "ar" : "en_US"} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />
<meta property="og:image:alt" content={fullTitle} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={fullTitle} />
<JsonLd data={jsonLd} />
