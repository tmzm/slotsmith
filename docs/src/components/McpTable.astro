---
/**
 * The `slotsmith-ai` MCP server's tools or prompts, one row each: the name,
 * what it gives the agent and its arguments (optional ones marked). The
 * description comes before the arguments, so a phone shows it without
 * scrolling sideways. Read from `@/data/mcp`, which a test keeps equal to
 * the server's source. Each
 * row is `#tool-<name>` or `#prompt-<name>`. The descriptions are English.
 */
import "@/styles/reference.css";
import { t, type Lang } from "@/i18n";
import { MCP_PROMPTS, MCP_TOOLS } from "@/data/mcp";

interface Props {
  kind: "tools" | "prompts";
  lang?: Lang;
}

const { kind, lang = "en" } = Astro.props;
const rows = kind === "tools" ? MCP_TOOLS : MCP_PROMPTS;
const descLang = lang === "en" ? undefined : "en";
/** Splits a description into text and `code` runs. */
const runs = (text: string) => text.split(/`([^`]+)`/).map((run, index) => ({ text: run, code: index % 2 === 1 }));
---
<div class="ref-table mcp-table" role="region" tabindex="0" aria-label={t(lang, kind === "tools" ? "mcp.tools" : "mcp.prompts")}>
  <table>
    <thead>
      <tr>
        <th scope="col">{t(lang, kind === "tools" ? "mcp.tool" : "mcp.prompt")}</th>
        <th scope="col">{t(lang, "mcp.does")}</th>
        <th scope="col">{t(lang, "mcp.args")}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr id={`${kind === "tools" ? "tool" : "prompt"}-${row.name}`}>
          <th scope="row" class="ref-name"><code dir="ltr">{row.name}</code></th>
          <td class="ref-desc-cell ref-desc" lang={descLang} dir={descLang && "ltr"}>
            {runs(row.description).map((run) => (run.code ? <code>{run.text}</code> : run.text))}
          </td>
          <td class="ref-type" data-label={t(lang, "mcp.args")}>
            {row.args.length === 0 ? (
              <span class="mcp-none">{t(lang, "mcp.none")}</span>
            ) : (
              row.args.map((arg, index) => (
                <>
                  {index > 0 && ", "}
                  <code dir="ltr">{arg}</code>
                  {row.optional?.includes(arg) && <span class="mcp-optional"> ({t(lang, "mcp.optional")})</span>}
                </>
              ))
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .mcp-none,
  .mcp-optional {
    color: var(--muted);
    font-family: var(--font-body);
  }

  /*
   * On phones each row stacks: the name, then what it gives the agent, then
   * its arguments under their column name, so nothing scrolls sideways.
   */
  @media (max-width: 767px) {
    .mcp-table table {
      min-inline-size: 0;
    }

    .mcp-table thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .mcp-table tr {
      display: grid;
      gap: 0.25rem;
      padding-block: 0.5rem;
      border-block-end: 1px solid var(--line);
    }

    .mcp-table tbody tr:last-child {
      border-block-end: 0;
    }

    .mcp-table th,
    .mcp-table td {
      display: block;
      padding-block: 0;
      border-block-end: 0;
      max-inline-size: none;
      min-inline-size: 0;
    }

    .mcp-table td[data-label]::before {
      content: attr(data-label) ": ";
      color: var(--muted);
      font-family: var(--font-body);
    }
  }
</style>
