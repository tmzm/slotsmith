---
/**
 * Landing "Works with what you have" (docs/DESIGN.md section 6, item 5). A
 * slow marquee of the libraries' names as plain text wordmarks (official
 * monochrome marks wait on the owner, see LAUNCH-REPORT), each a link to the
 * page that shows the library working with slotsmith.
 *
 * The marquee is CSS only: the list is drawn twice and the track moves by
 * half its length, so the loop has no seam. The copy is hidden from
 * assistive tech and out of the tab order. The track runs toward the start
 * side (mirrored under `dir="rtl"`), pauses on hover and while a link has
 * focus, and under reduced motion becomes one static, wrapped row.
 */
import { localePath, t, type Lang } from "@/i18n";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const LIBRARIES = [
  { name: "shadcn/ui", href: "/components/data-table/adapters/#shadcn" },
  { name: "MUI", href: "/components/data-table/adapters/#mui" },
  { name: "Chakra UI", href: "/components/data-table/adapters/#chakra" },
  { name: "Tailwind CSS", href: "/theming/#tailwind" },
  { name: "TanStack Table", href: "/components/data-table/" },
  { name: "TanStack Query", href: "/components/data-table/guides/server-data/" },
];
---
<section class="works" aria-labelledby="works-title">
  <div class="works__intro">
    <h2 id="works-title" class="display works__title">{t(lang, "works.title")}</h2>
    <p class="works__lede">{t(lang, "works.lede")}</p>
  </div>

  <div class="marquee">
    <div class="marquee__track">
      {[false, true].map((copy) => (
        <ul class="marquee__list" aria-label={copy ? undefined : t(lang, "works.list")} aria-hidden={copy ? "true" : undefined}>
          {LIBRARIES.map((library) => (
            <li>
              <a class="marquee__item" href={localePath(lang, library.href)} lang="en" dir="ltr" tabindex={copy ? "-1" : undefined}>
                <span class="marquee__name">{library.name}</span>
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<script>
  // Keyboard focus stops the loop (CSS), which moves the track after the browser has
  // scrolled the focused link into view, so bring it into view again once the
  // track has settled. Once focus leaves the strip, scroll it back so the
  // loop runs from its own start again.
  for (const marquee of document.querySelectorAll<HTMLElement>(".marquee")) {
    marquee.addEventListener("focusin", (event) => {
      const link = event.target;
      if (!(link instanceof HTMLElement) || !link.matches(":focus-visible")) return;
      requestAnimationFrame(() => link.scrollIntoView({ block: "nearest", inline: "nearest" }));
    });
    marquee.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && marquee.contains(event.relatedTarget)) return;
      marquee.scrollLeft = 0;
    });
  }
</script>

<style>
  .works {
    display: grid;
    gap: 2.5rem;
    padding-block: 4rem;
    border-block-start: 1px solid var(--line);
  }

  .works__intro {
    display: grid;
    gap: 0.75rem;
  }

  .works__title {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.25rem, 1.2rem + 4.4vw, 4.5rem);
    text-wrap: balance;
  }

  :global(html[lang="ar"]) .works__title {
    font-size: clamp(1.875rem, 1.2rem + 3vw, 3.5rem);
    line-height: 1.3;
  }

  .works__lede {
    margin: 0;
    max-inline-size: 52ch;
    color: var(--ink-2);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* The strip bleeds to the hairlines; the track scrolls inside it. */
  .marquee {
    --marquee-gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    --marquee-shift: -50%;
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding-block: 1.5rem;
  }

  :global(html[dir="rtl"]) .marquee {
    --marquee-shift: 50%;
  }

  .marquee__track {
    display: flex;
    inline-size: max-content;
    animation: marquee 60s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  /* Keyboard focus (not a click's focus, which would move the link out from
     under the pointer) stops the loop at its start, so the strip can scroll the
     focused link fully into view (a paused offset could leave it clipped). */
  .marquee:has(:focus-visible) .marquee__track {
    animation: none;
  }

  @keyframes marquee {
    to {
      transform: translateX(var(--marquee-shift));
    }
  }

  .marquee__list {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    margin: 0;
    padding: 0;
    padding-inline-end: var(--marquee-gap);
    list-style: none;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 320ms var(--ease-out);
  }

  .marquee__item:hover,
  .marquee__item:focus-visible {
    color: var(--gold-text);
  }

  /* Each name as a plain wordmark in the project's own casing. */
  .marquee__name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.005em;
  }

  /* Reduced motion: no loop, one wrapped row, no copy. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      inline-size: auto;
      animation: none;
    }

    .marquee__list {
      flex-wrap: wrap;
      row-gap: 0.75rem;
      column-gap: 2.5rem;
      padding-inline-end: 0;
    }

    .marquee__list[aria-hidden="true"] {
      display: none;
    }
  }
</style>
