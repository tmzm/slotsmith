---
/**
 * Landing "Two kinds of parts" (docs/DESIGN.md section 6, item 3). Two
 * columns, each framed by a pair of giant display brackets: `< >` in ink
 * around the element part, `{ }` in gold around the widget part, each with
 * one sample's code (no live demo). Below them, the README's table of what
 * each kind receives, and a link to the guides.
 *
 * Every part label takes its kind from the generated reference. The brackets
 * are decorative and hidden from assistive tech. The braces are the display
 * face; the angle brackets are drawn, since the display face sets them as
 * short wedges. In right-to-left text the browser mirrors the braces and CSS
 * mirrors the drawn brackets, so each pair still opens on the start side.
 */
import SampleCode from "@/components/SampleCode.astro";
import { localePath, t, type Lang, type MessageKey } from "@/i18n";
import { bracketLabel, slotKinds } from "@/lib/explode";
import { getReference } from "@/lib/reference";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const reference = getReference("data-table");

const kinds = [
  {
    kind: "element",
    title: "parts.elementTitle",
    text: "parts.element",
    sample: "landing/element-part",
    example: "Row",
    open: "<",
    close: ">",
    listed: ["Root", "Table", "Row", "Cell"],
    receives: "parts.elementReceives",
    dropIn: "parts.elementDropIn",
  },
  {
    kind: "widget",
    title: "parts.widgetTitle",
    text: "parts.widget",
    sample: "landing/widget-part",
    example: "Checkbox",
    open: "{",
    close: "}",
    listed: ["Checkbox", "Pagination", "Empty"],
    receives: "parts.widgetReceives",
    dropIn: "parts.widgetDropIn",
  },
] as const satisfies readonly {
  kind: "element" | "widget";
  title: MessageKey;
  text: MessageKey;
  receives: MessageKey;
  dropIn: MessageKey;
  [key: string]: unknown;
}[];

const columns = kinds.map((column) => {
  const [example] = slotKinds(reference, [column.example]);
  const listed = slotKinds(reference, [...column.listed]);
  // The column's claim must match the reference, or the page would teach the wrong kind.
  for (const part of [example!, ...listed]) {
    if (part.kind !== column.kind) throw new Error(`Slot "${part.slot}" is a ${part.kind} part, not a ${column.kind} part.`);
  }
  return { ...column, example: example!, listed };
});

/** Splits a message into text and `code` runs; Latin words in Arabic text are marked English. */
const runs = (message: string) =>
  message.split(/`([^`]+)`/).flatMap((run, index) =>
    index % 2 === 1
      ? [{ text: run, code: true, latin: true }]
      : lang === "ar"
        ? run.split(/([A-Za-z][A-Za-z0-9/.+-]*)/).map((part, inner) => ({ text: part, code: false, latin: inner % 2 === 1 }))
        : [{ text: run, code: false, latin: false }],
  );
---
<section class="parts" aria-labelledby="parts-title">
  <div class="parts__intro">
    <h2 id="parts-title" class="display parts__title">{t(lang, "parts.title")}</h2>
    <p class="parts__lede">{t(lang, "parts.lede")}</p>
  </div>

  <div class="parts__columns">
    {columns.map((column) => (
      <div class:list={["parts__kind", `parts__kind--${column.kind}`]}>
        <span class="parts__glyph parts__glyph--open" aria-hidden="true" data-glyph={column.open}>
          {column.kind === "element" ? <svg viewBox="0 0 40 100" fill="none"><path d="M34 4 6 50l28 46" /></svg> : column.open}
        </span>
        <div class="parts__body">
          <h3 class="parts__name">
            <code class:list={["part-label", `part-label--${column.kind}`]} dir="ltr">{bracketLabel(column.example)}</code>
            <span>{t(lang, column.title)}</span>
          </h3>
          <p class="parts__text">
            {runs(t(lang, column.text)).map((run) =>
              run.code ? <code dir="ltr">{run.text}</code> : run.latin ? <span lang="en">{run.text}</span> : run.text,
            )}
          </p>
          <SampleCode name={column.sample} />
        </div>
        <span class="parts__glyph parts__glyph--close" aria-hidden="true" data-glyph={column.close}>
          {column.kind === "element" ? <svg viewBox="0 0 40 100" fill="none"><path d="M6 4l28 46L6 96" /></svg> : column.close}
        </span>
      </div>
    ))}
  </div>

  <div class="parts__table-wrap" tabindex="0" role="region" aria-label={t(lang, "parts.tableCaption")}>
    <table class="parts__table">
      <caption class="visually-hidden">{t(lang, "parts.tableCaption")}</caption>
      <thead>
        <tr>
          <th scope="col">{t(lang, "parts.kind")}</th>
          <th scope="col">{t(lang, "parts.receives")}</th>
          <th scope="col">{t(lang, "parts.dropIn")}</th>
        </tr>
      </thead>
      <tbody>
        {columns.map((column) => (
          <tr>
            <th scope="row">
              <span class="parts__row-title">{t(lang, column.title)}</span>
              <span class="parts__labels" dir="ltr">
                {column.listed.map((part) => (
                  <code class:list={["part-label", `part-label--${part.kind}`]}>{bracketLabel(part)}</code>
                ))}
              </span>
            </th>
            {[column.receives, column.dropIn].map((key) => (
              <td>
                {runs(t(lang, key)).map((run) =>
                  run.code ? <code dir="ltr">{run.text}</code> : run.latin ? <span lang="en">{run.text}</span> : run.text,
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="parts__more">
    <a href={localePath(lang, "/guides/")}>
      {t(lang, "parts.guides")}
      <svg class="parts__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" />
      </svg>
    </a>
  </p>
</section>

<style>
  .parts {
    display: grid;
    gap: 2.5rem;
    padding-block: 4rem;
    border-block-start: 1px solid var(--line);
  }

  .parts__intro {
    display: grid;
    gap: 0.75rem;
  }

  .parts__title {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.25rem, 1.2rem + 4.4vw, 4.5rem);
    text-wrap: balance;
  }

  :global(html[lang="ar"]) .parts__title {
    font-size: clamp(1.875rem, 1.2rem + 3vw, 3.5rem);
    line-height: 1.3;
  }

  .parts__lede {
    margin: 0;
    max-inline-size: calc(52 * var(--ch));
    color: var(--ink-2);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .parts__columns {
    display: grid;
    gap: 2.5rem;
  }

  /* Mobile: the opening bracket above the column at the start, the closing
     one below it at the end, like a block of code. */
  .parts__kind {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-inline-size: 0;
  }

  .parts__glyph {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(4.5rem, 3rem + 6vw, 8rem);
    line-height: 0.8;
    user-select: none;
  }

  .parts__glyph--close {
    justify-self: end;
  }

  /* The drawn angle brackets: as tall as a brace, with a stroke to match. */
  .parts__glyph svg {
    display: block;
    inline-size: 0.36em;
    block-size: 0.8em;
    stroke: currentColor;
    stroke-width: 11;
    stroke-linejoin: miter;
  }

  :global(html[dir="rtl"]) .parts__glyph svg {
    transform: scaleX(-1);
  }

  .parts__kind--element .parts__glyph {
    color: var(--ink);
  }

  .parts__kind--widget .parts__glyph {
    color: var(--gold);
  }

  .parts__body {
    display: grid;
    align-content: start;
    gap: 1rem;
    min-inline-size: 0;
    padding-block: 0.75rem;
  }

  .parts__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }

  .part-label {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .parts__name .part-label {
    font-size: 1.5rem;
  }

  .part-label--element {
    color: var(--ink);
  }

  .part-label--widget {
    color: var(--gold-text);
  }

  .parts__text {
    margin: 0;
    max-inline-size: calc(60 * var(--ch));
    color: var(--ink-2);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .parts__text code,
  .parts__table td code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .parts__body :global(.sample-code) {
    min-inline-size: 0;
  }

  /* Wide: the brackets stand on either side of their column, full height. */
  @media (min-width: 640px) {
    .parts__kind {
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: 1rem;
      align-items: stretch;
    }

    .parts__glyph {
      display: flex;
      align-items: center;
    }

    .parts__glyph--close {
      justify-self: auto;
    }
  }

  @media (min-width: 1200px) {
    .parts__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  .parts__table-wrap:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .parts__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--panel);
  }

  .parts__table {
    inline-size: 100%;
    min-inline-size: 36rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .parts__table th,
  .parts__table td {
    padding: 0.875rem 1rem;
    text-align: start;
    vertical-align: top;
    border-block-end: 1px solid var(--line);
  }

  .parts__table tbody tr:last-child > * {
    border-block-end: 0;
  }

  .parts__table thead th {
    color: var(--muted);
    font-weight: 500;
  }

  .parts__table tbody tr {
    transition: background-color 200ms var(--ease-out);
  }

  .parts__table tbody tr:hover {
    background: var(--panel-2);
  }

  .parts__table tbody th {
    display: grid;
    justify-items: start;
    gap: 0.375rem;
    font-weight: 600;
    color: var(--ink);
  }

  .parts__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
    font-size: 0.8125rem;
  }

  .parts__table td {
    color: var(--ink-2);
  }

  .parts__more {
    margin: 0;
  }

  .parts__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    color: var(--gold-text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .parts__arrow {
    inline-size: 1rem;
    block-size: 1rem;
    transition: transform 200ms var(--ease-out);
  }

  .parts__more a:hover .parts__arrow {
    transform: translateX(2px);
  }

  :global(html[dir="rtl"]) .parts__arrow {
    transform: scaleX(-1);
  }

  :global(html[dir="rtl"]) .parts__more a:hover .parts__arrow {
    transform: scaleX(-1) translateX(2px);
  }
</style>
