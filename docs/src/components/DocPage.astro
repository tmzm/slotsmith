---
/**
 * One docs page: layout, header, prose (or the stub marker when there is none).
 * Every page template except the landing renders through this, so the stub
 * convention, the answer-first header, the Markdown controls, the JSON-LD
 * (`TechArticle`, `BreadcrumbList`, and `FAQPage` when the prose has an FAQ)
 * and the last-updated date live in one place.
 */
import Docs from "@/layouts/Docs.astro";
import CopyMarkdown from "@/components/CopyMarkdown.astro";
import PageHeader from "@/components/PageHeader.astro";
import Prose from "@/components/Prose.astro";
import { render } from "astro:content";
import { localePath, t, type Lang } from "@/i18n";
import { lastModified } from "@/lib/git-dates";
import { canonicalUrl } from "@/lib/page";
import { allPages } from "@/lib/pages";
import type { Prose as ProseData } from "@/lib/prose";
import { breadcrumbs, faqPage, techArticle } from "@/lib/structured-data";

interface Props {
  lang: Lang;
  /** Language-neutral path with trailing slash. */
  path: string;
  /** Used when there is no prose yet. */
  fallback?: { title: string; description: string };
  prose?: ProseData;
  /** The `{key} value` row under the title. */
  meta?: { key: string; value: string }[];
  /** Overrides the prose title (component API and adapters pages). */
  title?: string;
  /** Overrides the prose description, for one filled in at build (the changelog's names the latest version). */
  description?: string;
  /** False for a page whose content is generated rather than written in prose, so it is complete without an MDX entry. */
  stub?: boolean;
  /** Headings the page renders itself, listed in "On this page" after the prose's. */
  headings?: { id: string; text: string; depth: 2 | 3 }[];
  /** Components the prose MDX may use (a component overview's blocks). */
  components?: Record<string, unknown>;
}

const { lang, path, prose, fallback, meta, title: titleOverride, description: descriptionOverride, stub: stubOverride, headings: own = [], components } = Astro.props;
const title = titleOverride ?? prose?.entry.data.title ?? fallback?.title ?? "";
const description = descriptionOverride ?? prose?.entry.data.description ?? fallback?.description ?? "";
const sourcePath = prose?.sourcePath;
// An Arabic page showing English prose: the header and the contents links are English too.
const contentLang = lang === "ar" && prose && !prose.translated ? "en" : undefined;
const stub = stubOverride ?? (prose ? prose.entry.data.draft === true : true);
const headings = prose ? (await render(prose.entry)).headings : [];
const toc = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ id: h.slug, text: h.text, depth: h.depth as 2 | 3 })),
  ...own,
];

// The page as the sitemap knows it: its source files give the last-updated date.
const pages = (await allPages()).filter((page) => page.lang === lang);
const info = pages.find((page) => page.path === path);
if (!info) throw new Error(`No page "${path}" in allPages() for ${lang}.`);
const dateModified = lastModified(info.sources);
// The trail: the landing, then every page whose path this one's starts with.
const trail = [
  { name: t(lang, "site.name"), url: canonicalUrl(lang, "/") },
  ...pages
    .filter((page) => page.kind !== "landing" && path.startsWith(page.path) && page.path !== path)
    .sort((a, b) => a.path.length - b.path.length)
    .map((page) => ({ name: page.title, url: canonicalUrl(lang, page.path) })),
  { name: title, url: canonicalUrl(lang, path) },
];
const faq = prose?.entry.data.faq;
const jsonLd = [
  // `inLanguage` is the text's language: English on an Arabic page that shows English prose.
  techArticle({ title, description, url: canonicalUrl(lang, path), lang: contentLang ?? lang, dateModified }),
  breadcrumbs(trail),
  ...(faq?.length ? [faqPage(faq)] : []),
];
---
<Docs lang={lang} title={title} description={description} path={path} sourcePath={sourcePath} toc={toc} stub={stub} tocLang={contentLang} jsonLd={jsonLd} lastUpdated={dateModified}>
  <PageHeader title={title} lead={prose ? undefined : description} meta={meta} contentLang={contentLang}>
    <CopyMarkdown lang={lang} href={`${localePath(lang, path)}index.md`} />
  </PageHeader>
  {prose ? <Prose prose={prose} components={components} /> : stub && <p>{t(lang, "common.stub")}</p>}
  <slot />
</Docs>
