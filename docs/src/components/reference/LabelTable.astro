---
/**
 * The labels table of one component: key, type, English default and
 * description, from the generated reference. A function label shows its
 * signature in the Type column and, under Default, a call with example
 * arguments and what the English default prints for it. Defaults the
 * generator could not read (spread in from another object) come from the
 * library's exported labels object. Each row is `#label-<key>`. With
 * `section="validation"` it lists the component's second labels section
 * instead (the file uploader's validation messages), read from the same
 * reference.
 */
import "@/styles/reference.css";
import * as slotsmith from "slotsmith";
import Text from "./Text.astro";
import Type from "./Type.astro";
import type { ComponentSlug } from "@/data/components";
import { t, type Lang } from "@/i18n";
import { exampleArgs, formatArg, formatDefault, isFunctionType } from "@/lib/format";
import { getReference } from "@/lib/reference";

interface Props {
  slug: ComponentSlug;
  lang?: Lang;
  /** Which labels: the component's own (the default), or its validation messages. */
  section?: "labels" | "validation";
}

const { slug, lang = "en", section = "labels" } = Astro.props;
const reference = getReference(slug);
const validation = section === "validation";
const labels = (validation ? reference.validationLabels : reference.labels) ?? [];
const labelsExport = validation ? reference.validationLabelsExport : reference.labelsExport;
if (validation && (!labelsExport || labels.length === 0)) throw new Error(`The ${slug} reference has no validation labels.`);
const runtime = (slotsmith as unknown as Record<string, Record<string, unknown> | undefined>)[labelsExport!];
if (!runtime) throw new Error(`slotsmith does not export "${labelsExport}", the ${slug} labels.`);

/** What one label's Default cell shows. */
function describe(name: string, type: string, source: string | undefined): { value?: string; call?: string; output?: string } {
  const value = runtime![name];
  if (typeof value === "function" && isFunctionType(type)) {
    const args = exampleArgs(type);
    const output = (value as (...a: unknown[]) => unknown)(...args);
    return {
      call: `${name}(${args.map(formatArg).join(", ")})`,
      output: typeof output === "string" || typeof output === "number" ? JSON.stringify(output) : undefined,
    };
  }
  if (source) return { value: formatDefault(source) };
  if (typeof value === "string") return { value: JSON.stringify(value) };
  return {};
}

const rows = labels.map((label) => ({ label, shown: describe(label.name, label.type, label.default) }));
---
<div class="ref-table" role="region" tabindex="0" aria-label={`${reference.exportName} ${t(lang, validation ? "ref.validationLabelsLabel" : "ref.labelsLabel")}`}>
  <table>
    <thead>
      <tr>
        <th scope="col">{t(lang, "ref.key")}</th>
        <th scope="col">{t(lang, "ref.type")}</th>
        <th scope="col">{t(lang, "ref.englishDefault")}</th>
        <th scope="col">{t(lang, "ref.description")}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(({ label, shown }) => (
        <tr id={`label-${label.name}`}>
          <th scope="row" class="ref-name">
            <Type text={label.name} camel />
          </th>
          <td class="ref-type">
            <Type text={label.type} />
          </td>
          <td class="ref-default">
            {shown.value && <Type text={shown.value} />}
            {shown.call && (
              <>
                <Type text={shown.call} />
                {shown.output && (
                  <p class="ref-example">
                    {t(lang, "ref.example")} <code dir="ltr">{shown.output}</code>
                  </p>
                )}
              </>
            )}
            {!shown.value && !shown.call && <span class="ref-none">{formatDefault(undefined)}</span>}
          </td>
          <td class="ref-desc-cell">
            <Text text={label.description} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
