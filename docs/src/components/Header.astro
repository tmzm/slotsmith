---
/**
 * Site header: wordmark, version tag, search slot (filled by the search
 * island), GitHub, npm, language and theme. A hairline below.
 */
import Wordmark from "./Wordmark.astro";
import LangSwitch from "./LangSwitch.astro";
import { localePath, t, type Lang } from "@/i18n";
import { SITE } from "../../site.config.ts";
import pkg from "../../../package.json";

interface Props {
  lang: Lang;
  path: string;
  /** True when the page has no sidebar column: the menu button always opens the sheet, never collapses a column. */
  sheetOnly: boolean;
}

const { lang, path, sheetOnly } = Astro.props;
const [major, minor] = pkg.version.split(".");
const version = `${major}.${minor}`;
---
<header class="site-header">
  <div class="site-header__inner">
    <button
      type="button"
      class="icon-button menu-button"
      data-menu-toggle
      data-sheet-only={sheetOnly || undefined}
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label={t(lang, "common.menu")}
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h10" />
      </svg>
    </button>
    <Wordmark lang={lang} />
    <a class="version-tag" href={localePath(lang, "/changelog/")} aria-label={t(lang, "common.version", { version })} dir="ltr">
      <span class="brace">{"{"}</span>v{version}<span class="brace">{"}"}</span>
    </a>
    <span class="site-header__spacer"></span>
    <div id="search-slot"></div>
    <a class="icon-button ext-link" href={SITE.repo} aria-label={t(lang, "common.githubLabel")}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
      </svg>
    </a>
    <a class="icon-button ext-link" href={`https://www.npmjs.com/package/${SITE.npm}`} aria-label={t(lang, "common.npmLabel")}>
      <span class="mono" aria-hidden="true">npm</span>
    </a>
    <LangSwitch lang={lang} path={path} />
    <button
      type="button"
      class="icon-button theme-button"
      data-theme-toggle
      data-label-to-light={t(lang, "switch.toLight")}
      data-label-to-dark={t(lang, "switch.toDark")}
      aria-label={t(lang, "switch.toLight")}
    >
      <svg class="theme-icon-to-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="theme-icon-to-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
      </svg>
    </button>
  </div>
</header>
