{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noUncheckedSideEffectImports": false,
    "types": ["astro/client"]
  },
  "include": ["**/*", "../src/stylis.d.ts"],
  // The framework examples are apps of their own; the next-intl and i18next bridges are
  // display-only, since the docs do not install those libraries.
  "exclude": ["frameworks/", "languages/next-intl.tsx", "languages/i18next.tsx"]
}
