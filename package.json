{
  "name": "slotsmith",
  "version": "1.7.0",
  "description": "Finished data table, combobox, date picker and file uploader for React that drop into any design system: shadcn/ui, MUI, Chakra, Ant Design or your own. Every part is a slot; what you don't replace still looks finished.",
  "license": "ISC",
  "author": "Tareq Al-Mozayek",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./virtual": {
      "import": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/virtual.js"
      },
      "require": {
        "types": "./dist/virtual.d.ts",
        "default": "./dist/virtual.cjs"
      }
    },
    "./autocomplete": {
      "import": {
        "types": "./dist/autocomplete/index.d.ts",
        "default": "./dist/autocomplete.js"
      },
      "require": {
        "types": "./dist/autocomplete/index.d.ts",
        "default": "./dist/autocomplete.cjs"
      }
    },
    "./data-table": {
      "import": {
        "types": "./dist/data-table/index.d.ts",
        "default": "./dist/data-table.js"
      },
      "require": {
        "types": "./dist/data-table/index.d.ts",
        "default": "./dist/data-table.cjs"
      }
    },
    "./date-picker": {
      "import": {
        "types": "./dist/date-picker/index.d.ts",
        "default": "./dist/date-picker.js"
      },
      "require": {
        "types": "./dist/date-picker/index.d.ts",
        "default": "./dist/date-picker.cjs"
      }
    },
    "./file-uploader": {
      "import": {
        "types": "./dist/file-uploader/index.d.ts",
        "default": "./dist/file-uploader.js"
      },
      "require": {
        "types": "./dist/file-uploader/index.d.ts",
        "default": "./dist/file-uploader.cjs"
      }
    },
    "./locale": {
      "import": { "types": "./dist/locale/index.d.ts", "default": "./dist/locale.js" },
      "require": { "types": "./dist/locale/index.d.ts", "default": "./dist/locale.cjs" }
    },
    "./locales/*": {
      "import": { "types": "./dist/locales/*.d.ts", "default": "./dist/locales/*.js" },
      "require": { "types": "./dist/locales/*.d.ts", "default": "./dist/locales/*.cjs" }
    },
    "./provider": {
      "import": { "types": "./dist/provider/index.d.ts", "default": "./dist/provider.js" },
      "require": { "types": "./dist/provider/index.d.ts", "default": "./dist/provider.cjs" }
    },
    "./styles.css": "./dist/styles.css",
    "./autocomplete.css": "./dist/autocomplete.styles.css",
    "./data-table.css": "./dist/data-table.styles.css",
    "./date-picker.css": "./dist/date-picker.styles.css",
    "./file-uploader.css": "./dist/file-uploader.styles.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ai": "pnpm --filter slotsmith-ai build",
    "test:ai": "pnpm --filter slotsmith-ai test",
    "typecheck:ai": "pnpm --filter slotsmith-ai typecheck"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.2.0",
    "@tanstack/react-virtual": "^3.10.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "@tanstack/react-virtual": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "antd": "^6.6.5",
    "axe-core": "^4.13.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmzm/slotsmith.git"
  },
  "homepage": "https://slotsmith.dev/",
  "keywords": [
    "react",
    "table",
    "data-table",
    "headless",
    "tanstack",
    "slots",
    "unstyled",
    "accessible",
    "rtl",
    "i18n",
    "locale",
    "file-upload",
    "dropzone",
    "uploader",
    "date-picker",
    "calendar",
    "range",
    "theme",
    "themes"
  ],
  "bugs": {
    "url": "https://github.com/tmzm/slotsmith/issues"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9"
  }
}
