{
  "name": "slotsmith",
  "version": "1.0.0",
  "description": "A headless React component library: every part is a slot you can replace, with plain-HTML fallbacks. Starting with the data table.",
  "license": "ISC",
  "author": "Tareq Al-Mozayek",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./virtual": {
      "import": {
        "types": "./dist/data-table/virtual.d.ts",
        "default": "./dist/virtual.js"
      },
      "require": {
        "types": "./dist/data-table/virtual.d.ts",
        "default": "./dist/virtual.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9.2.0",
    "@tanstack/react-virtual": "^3.10.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.11",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tmzm/slotsmith.git"
  },
  "homepage": "https://slotsmith-docs.netlify.app",
  "keywords": [
    "react",
    "table",
    "data-table",
    "headless",
    "tanstack",
    "slots",
    "unstyled",
    "accessible",
    "rtl"
  ],
  "bugs": {
    "url": "https://github.com/tmzm/slotsmith/issues"
  }
}
